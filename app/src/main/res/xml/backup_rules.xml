<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup for Android 11 and lower (API 30-).

    Only the user's settings are restored. The Azaan audio can be tens of
    megabytes and is downloaded again on demand, and the prayer schedule is
    re-fetched from the API, so neither belongs in a cloud backup.
    (Azaan audio on Android 10+ is stored in the public Ringtones collection,
    which Auto Backup does not cover.)
-->
<full-backup-content>
    <include domain="sharedpref" path="namaz_times_prefs.xml" />
</full-backup-content>
