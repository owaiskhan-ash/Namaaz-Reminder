<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12+ (API 31+).

    Same intent as backup_rules.xml: carry the settings across, leave the
    downloaded Azaan audio (large, re-downloadable) and the cached schedule
    (re-fetched from the API) behind.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="namaz_times_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="namaz_times_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
